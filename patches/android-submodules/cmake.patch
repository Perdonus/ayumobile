diff --git a/external/rnnoise/CMakeLists.txt b/external/rnnoise/CMakeLists.txt
index a201e92..f1322ba 100644
--- a/external/rnnoise/CMakeLists.txt
+++ b/external/rnnoise/CMakeLists.txt
@@ -11,7 +11,55 @@ if (DESKTOP_APP_USE_PACKAGED)
     find_package(PkgConfig REQUIRED)
     pkg_check_modules(DESKTOP_APP_RNNOISE REQUIRED IMPORTED_TARGET rnnoise)
 
+    if (DESKTOP_APP_SPECIAL_TARGET STREQUAL "android")
+        set(DESKTOP_APP_RNNOISE_STATIC_LIBRARY "")
+
+        foreach(_library IN LISTS DESKTOP_APP_RNNOISE_LINK_LIBRARIES DESKTOP_APP_RNNOISE_LIBRARIES)
+            if (_library MATCHES "^/" AND _library MATCHES "\\.a$")
+                set(DESKTOP_APP_RNNOISE_STATIC_LIBRARY "${_library}")
+                break()
+            endif()
+        endforeach()
+
+        if (NOT DESKTOP_APP_RNNOISE_STATIC_LIBRARY)
+            pkg_get_variable(DESKTOP_APP_RNNOISE_PKG_LIBDIR rnnoise libdir)
+            if (DESKTOP_APP_RNNOISE_PKG_LIBDIR
+                AND EXISTS "${DESKTOP_APP_RNNOISE_PKG_LIBDIR}/librnnoise.a")
+                set(DESKTOP_APP_RNNOISE_STATIC_LIBRARY
+                    "${DESKTOP_APP_RNNOISE_PKG_LIBDIR}/librnnoise.a")
+            endif()
+        endif()
+
+        if (NOT DESKTOP_APP_RNNOISE_STATIC_LIBRARY)
+            foreach(_library_dir IN LISTS DESKTOP_APP_RNNOISE_LIBRARY_DIRS)
+                if (EXISTS "${_library_dir}/librnnoise.a")
+                    set(DESKTOP_APP_RNNOISE_STATIC_LIBRARY
+                        "${_library_dir}/librnnoise.a")
+                    break()
+                endif()
+            endforeach()
+        endif()
+
+        if (NOT DESKTOP_APP_RNNOISE_STATIC_LIBRARY)
+            message(FATAL_ERROR
+                "Failed to find packaged rnnoise static library for Android. "
+                "LIBRARIES='${DESKTOP_APP_RNNOISE_LIBRARIES}' "
+                "LIBRARY_DIRS='${DESKTOP_APP_RNNOISE_LIBRARY_DIRS}'")
+        endif()
+        target_link_libraries(external_rnnoise INTERFACE
+            "${DESKTOP_APP_RNNOISE_STATIC_LIBRARY}")
+        if (DESKTOP_APP_RNNOISE_INCLUDE_DIRS)
+            target_include_directories(external_rnnoise SYSTEM INTERFACE
+                ${DESKTOP_APP_RNNOISE_INCLUDE_DIRS})
+        endif()
+        return()
+    endif()
+
     target_link_libraries(external_rnnoise INTERFACE PkgConfig::DESKTOP_APP_RNNOISE)
+    if (DESKTOP_APP_RNNOISE_LIBRARY_DIRS)
+        set_property(TARGET external_rnnoise APPEND PROPERTY
+            INTERFACE_LINK_DIRECTORIES "${DESKTOP_APP_RNNOISE_LIBRARY_DIRS}")
+    endif()
     return()
 endif()
 
