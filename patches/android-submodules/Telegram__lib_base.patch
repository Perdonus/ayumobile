+	return base::Platform::FinalizeDeviceModel(QStringLiteral("Android"));
+}
+
+QString SystemVersionPretty() {
+	const auto pretty = QSysInfo::prettyProductName();
+	return pretty.isEmpty() ? QStringLiteral("Android") : pretty;
+}
+
+QString SystemCountry() {
+	const auto locale = QLocale::system().name();
+	const auto parts = locale.split(QLatin1Char('_'));
+	return (parts.size() > 1) ? parts.constLast() : QString();
+}
+
+QString SystemLanguage() {
+	const auto system = QLocale::system();
+	const auto languages = system.uiLanguages();
+	return languages.isEmpty()
+		? system.name().split(QLatin1Char('_')).value(0)
+		: languages.front();
+}
