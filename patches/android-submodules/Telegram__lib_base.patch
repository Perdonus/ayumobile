diff --git a/base/platform/android/base_file_utilities_android.cpp b/base/platform/android/base_file_utilities_android.cpp
new file mode 100644
index 0000000..5d6a115
--- /dev/null
+++ b/base/platform/android/base_file_utilities_android.cpp
@@ -0,0 +1,71 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+#include "base/platform/base_platform_file_utilities.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QUrl>
+#include <QtGui/QDesktopServices>
+
+#include <unistd.h>
+
+namespace base::Platform {
+
+void ShowInFolder(const QString &filepath) {
+	const auto info = QFileInfo(filepath);
+	const auto target = info.exists()
+		? info.absolutePath()
+		: filepath;
+	if (!target.isEmpty()) {
+		QDesktopServices::openUrl(QUrl::fromLocalFile(target));
+	}
+}
+
+QString FileNameFromUserString(QString name) {
+	return name;
+}
+
+bool DeleteDirectory(QString path) {
+	return QDir(path).removeRecursively();
+}
+
+void RemoveQuarantine(const QString &) {
+}
+
+QString CurrentExecutablePath(int argc, char *argv[]) {
+	const auto applicationPath = QCoreApplication::applicationFilePath();
+	if (!applicationPath.isEmpty()) {
+		return applicationPath;
+	} else if (argc > 0 && argv && argv[0]) {
+		return QFileInfo(QFile::decodeName(argv[0])).absoluteFilePath();
+	}
+	return QString();
+}
+
+QString BundledResourcesPath() {
+	return QCoreApplication::applicationDirPath();
+}
+
+bool RenameWithOverwrite(const QString &from, const QString &to) {
+	if (from == to) {
+		return true;
+	}
+	QFile::remove(to);
+	return QFile::rename(from, to);
+}
+
+void FlushFileData(QFile &file) {
+	file.flush();
+	const auto descriptor = file.handle();
+	if (descriptor >= 0) {
+		fsync(descriptor);
+	}
+}
+
+} // namespace base::Platform
